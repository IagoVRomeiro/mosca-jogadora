# Copie para .env (que não vai para o git) e preencha com os dados do projeto
# "mosca knight" no Supabase.
#
# SUPABASE_URL: Project Settings > Data API > Project URL.
#   Usa o ID do projeto (um código aleatório), não o nome "mosca knight":
#   ex.: https://abcdefghijklmnop.supabase.co
# SUPABASE_CHAVE: Project Settings > API Keys > chave secreta (sb_secret_...)
SUPABASE_URL=https://ID-DO-MOSCA-KNIGHT.supabase.co
SUPABASE_CHAVE=sb_secret_COLE_AQUI
